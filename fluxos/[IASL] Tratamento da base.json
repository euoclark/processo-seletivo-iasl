            {
              "id": "a53e743b-0fcc-44bb-8b7d-8226f08e9ece",
              "name": "pontuacao_cargo",
              "value": "={{ ($json.Cargo.toLowerCase().includes('ceo') || $json.Cargo.toLowerCase().includes('soci') || $json.Cargo.toLowerCase().includes('diretor')) ? 25 : (($json.Cargo.toLowerCase().includes('gerente') || $json.Cargo.toLowerCase().includes('coordenador')) ? 15 : ($json.Cargo.toLowerCase().includes('analista') ? 5 : 0)) }}",
              "type": "string"
            },
            {
              "id": "9b143210-e703-4c78-b4df-55ee3323191b",
              "name": "pontuacao_prazo",
              "value": "={{ ($json.Prazo.toLowerCase().includes('imediato') || $json.Prazo.toLowerCase().includes('urgente')) ? 20 : ($json.Prazo.toLowerCase().includes('3 meses') ? 10 : 0) }}",
              "type": "string"
            },
            {
              "id": "41d62a36-d080-4762-8bc2-c25545095c54",
              "name": "pontuacao_automacao",
              "value": "={{ $json.Automacao.toLowerCase().includes('sim') ? 15 : 10 }}",
              "type": "string"
            },
            {
              "id": "71f5999e-670f-4401-8834-a68263d2e699",
              "name": "pontuacao_faturamento",
              "value": "={{ \n  (() => {\n    const s = ($json.Faturamento || '').toString().toLowerCase().trim();\n    if (s.includes('prefiro')) return 0;\n    \n    let valor = 0;\n    if (s.includes('k')) {\n      // Pega o número antes do k e multiplica por 1000 (ex: 80k -> 80 * 1000 = 80000)\n      const num = parseFloat(s.replace(/[^\\d.]/g, '')) || 0;\n      valor = num * 1000;\n    } else {\n      const numStr = s.replace(/[^\\d]/g, '');\n      const parsed = parseFloat(numStr) || 0;\n      valor = s.includes(',') ? parsed / 100 : parsed;\n    }\n    \n    if (valor > 100000) return 30;\n    if (valor > 10000) return 15;\n    return 0;\n  })()\n}}",
              "type": "string"
            },
            {
              "id": "fc5e510b-efc0-4a8c-afc8-6c2aac48b11f",
              "name": "pontuacao_total",
              "value": "={{ \n  (($json.Cargo.toLowerCase().includes('ceo') || $json.Cargo.toLowerCase().includes('soci') || $json.Cargo.toLowerCase().includes('diretor')) ? 25 : (($json.Cargo.toLowerCase().includes('gerente') || $json.Cargo.toLowerCase().includes('coordenador')) ? 15 : ($json.Cargo.toLowerCase().includes('analista') ? 5 : 0)))\n  +\n  (($json.Prazo.toLowerCase().includes('imediato') || $json.Prazo.toLowerCase().includes('urgente')) ? 20 : ($json.Prazo.toLowerCase().includes('3 meses') ? 10 : 0))\n  +\n  ($json.Automacao.toLowerCase().includes('sim') ? 15 : 10)\n  +\n  ((Number($json.Faturamento.toString().replace(/[^\\d]/g, '')) > 100000 || $json.Faturamento.toString().toLowerCase().includes('100k')) ? 30 : ((Number($json.Faturamento.toString().replace(/[^\\d]/g, '')) > 10000 || $json.Faturamento.toString().toLowerCase().includes('80k')) ? 15 : 0))\n}}",
              "type": "number"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
